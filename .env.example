# PostgreSQL (docker sgp_postgres :5436). Admin DSNs: Skill servers, migrations, tests. Never commit .env.
SGP_PG_DSN=
SGP_TEST_PG_DSN=
# app role for the Streamlit demo (sql/002 role, grants 006/008/009); the app refuses any other user
SGP_AGENT_PW=
SGP_AGENT_PG_DSN=
SGP_AGENT_TEST_PG_DSN=
# LLM (S4a-05). Defaults rule/template make no paid call; an unset budget refuses every reservation
ANTHROPIC_API_KEY=
SGP_LLM_ROUTER=
SGP_LLM_NARRATOR=
SGP_LLM_MODEL=
SGP_LLM_BUDGET_USD=
# demo
SGP_DEMO_MANIFEST=
SGP_DEMO_SYNTHETIC=
SGP_TURN_LEASE_SECONDS=
SGP_MCP_TIMEOUT=
# Skill servers
SGP_GATE_REF=
SGP_DETECTOR_DIR=
SGP_DIAGNOSER_DIR=
SGP_GATE_CALIB=
SGP_PROCESSED_DIR=
SGP_RETRIEVAL_DIR=
SGP_FAULT_MAP=
SGP_TAU_PATH=
SGP_DEVICE=
SGP_REQUEST_STALE_SECONDS=
# other APIs (Stage 0 spikes)
OPENAI_API_KEY=
GOOGLE_API_KEY=
DATA_GO_KR_KEY=
